{
  "bar": {
    "centerAnchor": "caste.workspaces",
    "layout": {
      "left": [
        {
          "id": "caste.menu"
        },
        {
          "id": "caste.cpu"
        },
        {
          "id": "caste.ip"
        },
        {
          "id": "caste.target"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "caste.workspaces"
        }
      ],
      "right": [
        {
          "id": "caste.tray"
        },
        {
          "id": "caste.network"
        },
        {
          "id": "caste.volume"
        },
        {
          "id": "caste.battery"
        },
        {
          "format": "HH:mm",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
